# ---------------------------------------------------------------
# Copy to .env.local and fill in. Everything here is optional —
# the app runs fine with none of it, just without email.
# ---------------------------------------------------------------

# Public URL of this install. Used to build links inside emails.
APP_URL=http://localhost:3000

# --- Claiming the CEO seat ---
# Signing up first does NOT make you the CEO. Whoever enters this code on the
# signup form is created as CEO instead of the role they picked. Set it to
# something only you know, and it can be removed once your CEO account exists.
CEO_SETUP_CODE=change-me-to-something-secret

# --- Gmail SMTP ---
# 1. Turn on 2-Step Verification on your Google account.
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an App Password (16 characters) and paste it below.
#    Your normal Gmail password will NOT work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=Flow <you@gmail.com>

# --- Google Meet / Calendar (optional) ---
# One central Google account books every meeting, so nobody using Flow ever
# connects a Google account of their own. Without these, meetings still save
# but carry no Meet link and the organiser is offered a retry.
#
# 1. console.cloud.google.com -> new project -> enable the Google Calendar API.
# 2. OAuth consent screen -> External -> add scope
#    https://www.googleapis.com/auth/calendar.events
# 3. IMPORTANT: set publishing status to "In production". Left in "Testing",
#    Google expires the refresh token after 7 days and meetings quietly stop
#    working a week after you launch.
# 4. Credentials -> OAuth client ID -> Web application, with the authorised
#    redirect URI http://localhost:5555/callback
# 5. Fill in the two values below, then run `npm run google:auth` once — it
#    prints the refresh token to paste in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Which calendar to book on. "primary" is the dedicated account's own.
GOOGLE_CALENDAR_ID=primary

# --- Database (only needed when deploying to Vercel + Supabase) ---
# Supabase → Project Settings → Database → Connection string → URI
# Use the "Connection pooling" URI on Vercel.
# DATABASE_URL=postgresql://postgres:...@...pooler.supabase.com:6543/postgres
