# ---------------------------------------------------------------
# Copy to .env.local and fill in. Everything here is optional —
# the app runs fine with none of it, just without email.
# ---------------------------------------------------------------

# Public URL of this install. Used to build links inside emails.
APP_URL=http://localhost:3000

# --- Claiming the CEO seat ---
# Signing up first does NOT make you the CEO. Whoever enters this code on the
# signup form is created as CEO instead of the role they picked. Set it to
# something only you know, and it can be removed once your CEO account exists.
# Legacy. Organisations are founded from the signup form now ("Start an
# organisation" makes you its CEO). This code only still claims the CEO seat of
# an install upgraded from before organisations existed. Safe to leave unset.
CEO_SETUP_CODE=change-me-to-something-secret

# --- Gmail SMTP ---
# 1. Turn on 2-Step Verification on your Google account.
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an App Password (16 characters) and paste it below.
#    Your normal Gmail password will NOT work.
# Mail goes out over the Gmail API by default, using the same GOOGLE_* client
# below — one HTTPS request, no mail host to resolve and no port 587 to hold
# open, which is what a serverless container is bad at. It needs the
# gmail.send scope on the refresh token: run `npm run google:auth` again if
# yours predates that.
#
# SMTP below is the fallback for installs with no Google account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=Flow <you@gmail.com>

# --- OpenRouter (optional) — better transcripts and real minutes ---
# Whisper does the listening in the browser; a language model turns what it
# heard into something readable: punctuation, mis-heard words repaired, Urdu
# written the way people actually type it, and meeting minutes instead of a
# wall of speech. Without a key everything still works, just rougher.
#
# Get a key at https://openrouter.ai/keys, and add a little credit — this is
# the one part of Flow that is not free. Llama 3.3 70B costs roughly a
# hundredth of a cent per voice note, so a few dollars lasts a very long time.
OPENROUTER_API_KEY=
# Optional. The code already defaults to this, so leave it out unless you want
# a different model. Do NOT use a ":free" slug — OpenRouter has withdrawn the
# free Llama tier, and the free models still listed either refuse the request
# or reply with their own reasoning instead of the transcript.
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
#
# The model that does the actual listening. Must be one that accepts audio —
# Gemini Flash is cheap, hears Urdu properly, and copes with a sentence that
# switches language halfway. OpenRouter will not accept audio at all until the
# account has a positive balance, so top it up before expecting this to work.
# Without a key, transcription falls back to the model in the browser.
# OPENROUTER_SPEECH_MODEL=google/gemini-2.5-flash

# --- Google Meet / Calendar (optional) ---
# One central Google account books every meeting, so nobody using Flow ever
# connects a Google account of their own. Without these, meetings still save
# but carry no Meet link and the organiser is offered a retry.
#
# 1. console.cloud.google.com -> new project -> enable the Google Calendar API.
# 2. OAuth consent screen -> External -> add scope
#    https://www.googleapis.com/auth/calendar.events
# 3. IMPORTANT: set publishing status to "In production". Left in "Testing",
#    Google expires the refresh token after 7 days and meetings quietly stop
#    working a week after you launch.
# 4. Credentials -> OAuth client ID -> Web application, with the authorised
#    redirect URI http://localhost:5555/callback
# 5. Fill in the two values below, then run `npm run google:auth` once — it
#    prints the refresh token to paste in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Which calendar to book on. "primary" is the dedicated account's own.
GOOGLE_CALENDAR_ID=primary

# --- Reaching people who are not looking at Flow (all optional, all free) ---
#
# Browser push: an alert on someone's phone or desktop even with the tab
# closed. Run `npm run push:keys` ONCE and paste what it prints. Do not
# regenerate later — it breaks every browser that already said yes.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
#
# Slack: a channel feed of what moved — raised, assigned, submitted, approved,
# sent back, mentions. Not every chat message. Make an incoming webhook at
# https://api.slack.com/messaging/webhooks and paste the URL.
SLACK_WEBHOOK_URL=

# --- Database (only needed when deploying to Vercel + Supabase) ---
# Supabase → Project Settings → Database → Connection string → URI
# Use the "Connection pooling" URI on Vercel.
# DATABASE_URL=postgresql://postgres:...@...pooler.supabase.com:6543/postgres
